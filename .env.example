# INV-1: the only accepted value. Anything else fails at boot, on purpose.
TRADING_MODE=paper

DB_PATH=./data/aegis.db

# debug | info | warn | error
LOG_LEVEL=info
VERBOSE=false

# Programmatic Claude usage bills from a separate monthly pool to your chat
# usage: roughly $20 on Pro, $100 on Max 5x, $200 on Max 20x. Set this to your
# pool, not your total spend — the Budget Governor degrades against it.
MONTHLY_BUDGET_USD=100
CLAUDE_CONCURRENCY=3

# Standardised earnings surprise a filing must clear before it is audited.
SUE_THRESHOLD=1.5
# Auditor score out of 100 a thesis must clear before an order is proposed.
AUDIT_FLOOR=70

DASHBOARD_PORT=3777

# Simulated starting balances, per venue.
STARTING_CASH=100000
STARTING_CASH_CRYPTO=25000

# SHADOW decides and logs but places nothing. Override with --autonomy AUTO.
AUTONOMY=SHADOW

# Where notifications go. The default transport prints to the terminal, so the
# system is fully runnable with no email provider configured.
NOTIFY_TO=operator@localhost

# SEC requires a real contact address in the User-Agent. Requests without one
# are refused. Put your own here.
SEC_USER_AGENT=Aegis Research you@example.com
