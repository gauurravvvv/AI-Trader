# INV-1: the only accepted value. Anything else fails at boot, on purpose.
TRADING_MODE=paper

DB_PATH=./data/aegis.db

# debug | info | warn | error
LOG_LEVEL=info
VERBOSE=false

# ── Money ────────────────────────────────────────────────────────────────────
# Simulated. There is no code path to a funded account.
STARTING_CASH=100000

# Fraction of equity per trade BEFORE the debate strength and the market regime
# scale it down. A 3% base with a grudging thesis in a risk-off tape is ~0.7%.
BASE_SIZE_PCT=0.03

# ── Limits ───────────────────────────────────────────────────────────────────
# How many positions may be held at once. Bounds total exposure.
MAX_OPEN_POSITIONS=8
# How many NEW entries per day. Bounds churn; the position cap does not.
MAX_TRADES_PER_DAY=5
# Analyst + challenger pairs per day. A runaway-loop backstop, NOT a budget.
# Claude Code draws from the same plan allowance as your chats, so spend is not
# the constraint; the plan usage limit is, and it announces itself by failing a
# call, which the system then backs off from. Set this far above a sane day.
MAX_ANALYSES_PER_DAY=400

# Who argues which side. Measured on this machine: haiku ~$0.003 a call,
# sonnet ~$0.05 even with a warm cache. The cheap model forms the view; the
# expensive one holds the veto, because that is the step that stops money
# moving. Set both to haiku to cut cost ~10x, or both to sonnet for quality.
ANALYST_MODEL=haiku
CHALLENGER_MODEL=sonnet

# ── Model spend ──────────────────────────────────────────────────────────────
# Reporting only. Claude Code shares your plan allowance with ordinary chat, so
# this is an API-equivalent yardstick for what the agents cost, not a wallet
# that can run out. Nothing is blocked when it is exceeded.
MONTHLY_BUDGET_USD=100
CLAUDE_CONCURRENCY=3

# Minutes between news sweeps. A measured tick is ~$0.015, so every 10 minutes
# is ~$63/month and every 20 is ~$31.
NEWS_INTERVAL_MIN=20

# ── Email ────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset to print notifications to the terminal instead.
# If you set it, you must set the rest — a half-configured mailer throws at boot
# rather than silently sending nothing.
#
# Gmail needs an App Password, not your account password:
#   https://myaccount.google.com/apppasswords
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Aegis <you@gmail.com>
# NOTIFY_TO=you@gmail.com

# ── Behaviour ────────────────────────────────────────────────────────────────
# SHADOW decides and logs but places nothing. Override with --autonomy AUTO.
AUTONOMY=SHADOW

DASHBOARD_PORT=3777
