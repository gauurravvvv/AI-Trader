# ── Our own build output ──────────────────────────────────────────
node_modules/
.next/
dist/
build/
out/
coverage/
*.log
__pycache__/
*.pyc
.venv/
venv/

# ── Secrets — never commit ────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
!.sample.env

# ── Generated trading artifacts (see docs/01-REQUIREMENTS.md) ─────
/output/
/TRADE-*.md
/TRADE-*.pdf

# ── OS junk ───────────────────────────────────────────────────────
.DS_Store

# ── reference/ holds faithful upstream copies. Our rules above must
#    not strip their content; each vendored repo's own .gitignore
#    still applies, which is what keeps the copy true to upstream.
!reference/**/*.pdf
!reference/**/*.env.example
!reference/**/.env.*.example
!reference/**/.sample.env
