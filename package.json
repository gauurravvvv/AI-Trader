{
  "name": "aegis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev": "node --env-file-if-exists=.env --import tsx apps/daemon/src/main.ts",
    "smoke:news": "pnpm --filter @aegis/daemon smoke:news",
    "report": "pnpm --filter @aegis/daemon report",
    "smoke:cost": "pnpm --filter @aegis/daemon smoke:cost",
    "soak": "scripts/soak.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^10.0.0"
  }
}
