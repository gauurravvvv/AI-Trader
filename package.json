{
  "name": "aegis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev": "node --import tsx apps/daemon/src/main.ts",
    "smoke:news": "pnpm --filter @aegis/daemon smoke:news",
    "report": "pnpm --filter @aegis/daemon report",
    "smoke:cost": "pnpm --filter @aegis/daemon smoke:cost"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
